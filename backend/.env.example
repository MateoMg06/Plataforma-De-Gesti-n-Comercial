# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube al repo.
PORT=3000
FRONTEND_URL=http://localhost:5173

# RDS PostgreSQL en us-east-2 (Ohio). DB_NAME debe existir en la instancia.
DB_HOST=comercial360-db.cbgw2sqsgn58.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_USER=comercial
DB_PASSWORD=comercial
DB_NAME=comercial360
DB_SSL=true
# RDS: DB_SSL=true y ruta absoluta al bundle CA descargado de AWS.
# Completar DB_SSL_CA con la ruta real del certificado. No subir el .pem al repositorio.
DB_SSL_CA=

# S3 (HU-INF-04, Daniel)
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# BetterAuth (HU-01, Kevin V)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
