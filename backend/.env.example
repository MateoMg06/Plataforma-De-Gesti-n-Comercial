# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube al repo.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Local: docker compose up -d (ver README). En AWS: datos de la instancia RDS.
DB_HOST=localhost
DB_PORT=5432
DB_USER=comercial
DB_PASSWORD=comercial
DB_NAME=comercial360
DB_SSL=false

# S3 (HU-INF-04, Daniel)
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# BetterAuth (HU-01, Kevin V)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
