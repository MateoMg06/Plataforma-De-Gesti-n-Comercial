# Copia este archivo como .env y llena tus valores. El .env NUNCA se sube al repo.
# Los valores de aquí son para desarrollo LOCAL (docker compose). Los de AWS van
# solo en el .env del servidor EC2: nunca escribas hosts ni contraseñas reales aquí.
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL local (docker compose). Si ya tienes otro PostgreSQL en el 5432, usa 5434.
DB_HOST=localhost
DB_PORT=5432
DB_USER=comercial
DB_PASSWORD=comercial
DB_NAME=comercial360
DB_SSL=false
# Solo en AWS RDS (HU-INF-02): DB_SSL=true y la ruta absoluta al bundle CA de RDS.
# Ver "PostgreSQL en AWS RDS" en el README. No subir el .pem al repositorio.
DB_SSL_CA=

# S3 (HU-29 / HU-INF-04, Daniel). Si S3_BUCKET está vacío, los documentos se
# guardan en memoria (solo para desarrollo: se pierden al reiniciar).
# En EC2 usa un rol de IAM y deja las llaves vacías.
AWS_REGION=us-east-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# BetterAuth (HU-01, Kevin V)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
